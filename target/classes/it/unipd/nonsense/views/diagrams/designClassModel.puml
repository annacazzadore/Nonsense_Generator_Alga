  + setPreviousView(previousView : String) : void
  + setAnalysisResult(analysisResult : AnalysisResult) : void
  + setSelectedTemplate(template : String) : void
  + setNumberValue(value : int) : void
  - handleEnd() : void
  - handleBack() : void
  - initializePreviousController(loader : FXMLLoader) : void
  + saveSentencesToFile(sentences : List<String>, filePath : String) : void
  + showGeneratedSentences(inputSentences : List<String>) : void
  - showErrorAlert(title : String, message : String) : void
}

class MainController {
  - analyze : Button
  - tree : CheckBox
  - sentence : TextField

  + setSentenceText(text : String) : void
  - showError(message : String) : void
  - showErrorDialog(toxicityScore : double) : void
  - analyzeSentence() : void
}

class Main {
  {readOnly} - MIN_HEIGHT : int
  {readOnly} - MIN_WIDTH : int
  {readOnly} - APP_TITLE : String
  {readOnly} - FXML_PATH : String

  + main(args : String[]) : void
  - handleLaunchException(e : Exception) : void
  + start(primaryStage : Stage) : void
}

class NoSyntaxTreeController {
  + {static} VIEW_TYPE : String {readOnly}
  + generate : Button
  + back : ImageView
  # getPreviousViewType() : String
  + initialize() : void
}

class AnalysisResult {
  - wordsByType : Map<String, Set<String>>
  - syntaxResponse : AnalyzeSyntaxResponse
  - originalText : String

  + setWordsByType(wordsByType : Map<String, Set<String>>) : void
  + getWordsByType() : Map<String, Set<String>>
  + setSyntaxResponse(syntaxResponse : AnalyzeSyntaxResponse) : void
  + getSyntaxResponse() : AnalyzeSyntaxResponse
  + setOriginalText(originalText : String) : void
  + getOriginalText() : String
}

class PopUpController {
  - toxicity : TextField
  - {static} PERCENTAGE_MULTIPLIER : double {readOnly}
  - {static} TOXICITY_RATE_FORMAT : String {readOnly}

  - formatToxicityRate(rate : double {readOnly}) : String
  - validateToxicityRate(rate : double {readOnly}) : void
  + setToxicityRate(rate : double {readOnly}) : void
}

class Words {
    - {readOnly} rand : Random
    # words : List<String>

    + Words(dictionaryPath : String)
    + getRandom() : String
    # getRandomFromDictionary(count : int) : List<String>
}

class Adjective {
  + Adjective()
}

class Noun {
  + Noun()
}

class Verb {
  + Verb()
}

Words <|-- Noun
Words <|-- Adjective
Words <|-- Verb
SyntaxController <|-- SyntaxTreeController
SyntaxController <|-- NoSyntaxTreeController

SyntaxTreeController ..> AnalysisResult
SyntaxTreeController --> DependencyTreeVisualizer
SyntaxController --> AnalysisResult
SyntaxController ..> SentenceGenerator
SyntaxController ..> MainController
SyntaxController ..> ResultsController
ResultsController --> AnalysisResult
ResultsController ..> SentenceAnalyzer
ResultsController ..> SyntaxTreeController
ResultsController ..> NoSyntaxTreeController
MainController ..> AnalysisResult
MainController ..> SentenceAnalyzer
MainController ..> SyntaxTreeController
MainController ..> NoSyntaxTreeController
MainController ..> PopUpController
Main ..> MainController
SentenceGenerator ..> Adjective
SentenceGenerator ..> Noun
SentenceGenerator ..> Verb
@enduml